#: data/org.gnome.Gnote.appdata.xml.in:7 data/org.gnome.Gnote.desktop.in:2
#: src/recentchanges.cpp:100 src/recentchanges.cpp:121
msgid "Gnote"
msgstr "Gnote"

#: data/org.gnome.Gnote.appdata.xml.in:8
msgid "A simple note-taking application"
msgstr "Une application simple pour prendre des notes"

#: data/org.gnome.Gnote.appdata.xml.in:10
msgid ""
"Gnote is a simple note-taking application for GNOME desktop environment. It "
"allows you to capture your ideas, link them together using WikiWiki-style "
"links, group together in notebooks and some extra features for everyday use."
msgstr ""
"Gnote est une application simple de prise de notes pour l’environnement "
"GNOME. Elle permet de recueillir vos idées, de les lier entre elles dans un "
"style WikiWiki, de les grouper dans des blocs-notes. Elle apporte aussi "
"diverses autres fonctionnalités d’usage quotidien."

#: data/org.gnome.Gnote.appdata.xml.in:13
msgid "Notes can be printed or exported as HTML documents."
msgstr ""
"Les notes peuvent être imprimées ou exportées en tant que documents HTML."

#: data/org.gnome.Gnote.appdata.xml.in:14
msgid ""
"Gnote also supports synchronization, making it simple to use it on multiple "
"devices."
msgstr ""
"Gnote prend également en charge la synchronisation, ce qui simplifie "
"l’utilisation sur plusieurs périphériques."

#: data/org.gnome.Gnote.appdata.xml.in:33
msgid "The Gnote Team"
msgstr "L’équipe de développement de Gnote"

#: data/org.gnome.Gnote.desktop.in:3
msgid "Take notes, link ideas, and stay organized"
msgstr "Prendre des notes, relier des idées, rester organisé"

#: data/org.gnome.Gnote.desktop.in:4
msgid "Note-taker"
msgstr "Application de prise de notes"

#. Translators: Search terms to find this application. Do NOT translate or localize the semicolons! The list MUST also end with a semicolon!
#: data/org.gnome.Gnote.desktop.in:6
msgid "notes;idea;link;organize;"
msgstr "notes;idée;lien;organiser;"

#: data/org.gnome.Gnote.desktop.in:19
msgid "New Window"
msgstr "Nouvelle fenêtre"

#: data/org.gnome.Gnote.desktop.in:23 src/notebooks/notebook.cpp:209
#: src/notemanagerbase.cpp:293 src/searchnoteswidget.cpp:343
msgid "New Note"
msgstr "Nouvelle note"

#: data/org.gnome.gnote.gschema.xml:6
msgid "Enable spellchecking"
msgstr "Activer la vérification orthographique"

#: data/org.gnome.gnote.gschema.xml:7
msgid ""
"If true, misspellings will be underlined in red, and correct spelling "
"suggestions shown in the right-click menu."
msgstr ""
"Si activé, les mots mal orthographiés seront soulignés en rouge, et des "
"suggestions d’orthographes correctes seront affichées dans le menu "
"contextuel."

#: data/org.gnome.gnote.gschema.xml:11
msgid "Automatically create links when typing"
msgstr "Créer automatiquement les liens lors de la saisie"

#: data/org.gnome.gnote.gschema.xml:12
msgid ""
"Enable this option to automatically create a link, when text matches note "
"title."
msgstr ""
"Activez cette option pour créer automatiquement un lien quand le texte "
"correspond au titre d’une note."

#: data/org.gnome.gnote.gschema.xml:16
msgid "Create links for URLs in notes"
msgstr "Créer des liens pour les URL dans les notes"

#: data/org.gnome.gnote.gschema.xml:17
msgid "Enable this option to create links for URLs in notes."
msgstr "Activez cette option pour créer des liens pour les URL dans les notes."

#: data/org.gnome.gnote.gschema.xml:21
msgid "Enable WikiWord highlighting"
msgstr "Activer le surlignage des mots Wiki"

#: data/org.gnome.gnote.gschema.xml:22
msgid ""
"Enable this option to highlight words ThatLookLikeThis. Clicking the word "
"will create a note with that name."
msgstr ""
"Activez cette option pour surligner les mots CommeCeluiCi. Un clic sur ce "
"mot créera une nouvelle note avec ce nom."

#: data/org.gnome.gnote.gschema.xml:26
msgid "Enable Auto bulleted lists"
msgstr "Activer les listes à puces automatiques"

#: data/org.gnome.gnote.gschema.xml:27
msgid ""
"Enable this option if you want bulleted lists to be automatic when you place "
"- or * at the beginning of a line."
msgstr ""
"Activez cette option si vous voulez que des listes à puces soient créées "
"automatiquement lorsque vous placez un − ou une * au début d’une ligne."

#: data/org.gnome.gnote.gschema.xml:31
msgid "Enable Middle-Click Paste On Icon"
msgstr "Activer le collage du presse-papiers par clic-milieu sur l’icône"

#: data/org.gnome.gnote.gschema.xml:32
msgid ""
"Enable this option if you want to be able to middle-click the Gnote icon to "
"paste timestamped content into the Start Here note."
msgstr ""
"Activez cette option si vous souhaitez qu’un clic-milieu sur l’icône Gnote "
"colle le contenu du presse-papiers, avec l’heure, dans la note « Démarrez "
"ici »."

#: data/org.gnome.gnote.gschema.xml:36
msgid "Enable custom font"
msgstr "Utiliser une police personnalisée"

#: data/org.gnome.gnote.gschema.xml:37
msgid ""
"If true, the font name set in custom-font-face will be used as the font when "
"displaying notes. Otherwise the desktop default font will be used."
msgstr ""
"Si activé, la police marquée dans custom-font-face sera utilisée comme "
"police d’affichage pour les notes. Sinon la police par défaut du bureau sera "
"utilisée."

#: data/org.gnome.gnote.gschema.xml:41
msgid "Custom Font Face"
msgstr "Type de caractères personnalisé"

#: data/org.gnome.gnote.gschema.xml:42
msgid ""
"If enable-custom-font is true, the font name set here will be used as the "
"font when displaying notes."
msgstr ""
"Si enable-custom-font est VRAI, la police définie ici sera utilisée pour "
"l’affichage des notes."

#: data/org.gnome.gnote.gschema.xml:46
msgid "Base highlight background color on system accent color"
msgstr ""
"Adapter la couleur de fond du surlignage aux couleurs accentuées du système"

#: data/org.gnome.gnote.gschema.xml:47
msgid ""
"When text is highlighted, determine background color based on system accent "
"color. Typically this means a lighter version of highlight."
msgstr ""
"Lorsque du texte est surligné,cette option détermine la couleur de fond en "
"fonction des couleurs accentuées du système. En pratique cela se traduit par "
"une version plus claire du surlignage."

#: data/org.gnome.gnote.gschema.xml:51
msgid "Background color for the highlighted text"
msgstr "Couleur de fond pour le texte surligné"

#: data/org.gnome.gnote.gschema.xml:52
msgid ""
"When text is highlighted, use this color for background. A string "
"gdk_rgba_parse() accepts. Only has effect when highlight-accent-color-based "
"is false."
msgstr ""
"Lorsque du texte est surligné, le fond prend la couleur choisie. Une chaîne "
"que gdk_rgba_parse() accepte. Ne s’applique que si highlight-accent-color-"
"based est défini à faux (« false »)."

#: data/org.gnome.gnote.gschema.xml:56
msgid "Color for the highlighted text"
msgstr "Couleur du texte surligné"

#: data/org.gnome.gnote.gschema.xml:57
msgid ""
"When text is highlighted, use this color for text. A string gdk_rgba_parse() "
"accepts. Only has effect when highlight-accent-color-based is false."
msgstr ""
"Lorsque du texte est surligné, il prend la couleur choisie. Une chaîne que "
"gdk_rgba_parse() accepte. Ne s’applique que si highlight-accent-color-based "
"est défini à faux (« false »)."

#: data/org.gnome.gnote.gschema.xml:61
msgid "Start Here Note"
msgstr "Note Démarrer ici"

#: data/org.gnome.gnote.gschema.xml:62
msgid ""
"The note URI of the note that should be considered the \"Start Here\" note, "
"which is always placed at the bottom of the Gnote note menu and also "
"accessible by hotkey."
msgstr ""
"L’URI de la note devant être considérée comme la note « Démarrer ici », qui "
"se trouve toujours au fond du menu notes de Gnote et qui est aussi "
"accessible par un raccourci clavier."

#: data/org.gnome.gnote.gschema.xml:66
msgid "Minimum number of notes to show in menu"
msgstr "Nombre minimum de notes à afficher dans le menu"

#: data/org.gnome.gnote.gschema.xml:67
msgid ""
"Integer determining the minimum number of notes to show in the Gnote note "
"menu."
msgstr ""
"Nombre entier indiquant le nombre minimum de notes à afficher dans le menu "
"de Notes Gnote."

#: data/org.gnome.gnote.gschema.xml:71
msgid "List of pinned notes"
msgstr "Liste des notes épinglées"

#: data/org.gnome.gnote.gschema.xml:72
msgid ""
"Whitespace-separated list of note URIs for notes that should always appear "
"in the Gnote note menu."
msgstr ""
"Liste des URI des notes, séparées par des espaces, qui doivent toujours être "
"affichées dans le menu de notes Gnote."

#: data/org.gnome.gnote.gschema.xml:76
msgid "Is main window maximized"
msgstr "Fenêtre principale maximisée"

#: data/org.gnome.gnote.gschema.xml:77
msgid "If true, Gnote window will be maximized."
msgstr "Si vrai, la fenêtre Gnote sera maximisée."

#: data/org.gnome.gnote.gschema.xml:81
msgid "Saved height of Search window"
msgstr "Hauteur enregistrée de la fenêtre de recherche"

#: data/org.gnome.gnote.gschema.xml:82
msgid "Determines pixel height of Search window; stored on Gnote exit."
msgstr ""
"Définit la hauteur en pixels de la fenêtre de recherche ; enregistré lorsque "
"Gnote est quitté."

#: data/org.gnome.gnote.gschema.xml:86
msgid "Saved width of Search window"
msgstr "Largeur enregistrée de la fenêtre de recherche"

#: data/org.gnome.gnote.gschema.xml:87
msgid "Determines pixel width of Search window; stored on Gnote exit."
msgstr ""
"Définit la largeur en pixels de la fenêtre de recherche ; enregistré lorsque "
"Gnote est quitté."

#: data/org.gnome.gnote.gschema.xml:91
msgid "Saved splitter position of Search window splitter."
msgstr "Position du séparateur enregistrée de la fenêtre de recherche."

#: data/org.gnome.gnote.gschema.xml:92
msgid ""
"Determines Search window splitter position in pixels; stored on Gnote exit."
msgstr ""
"Définit la position en pixels du séparateur de la fenêtre de recherche ; "
"enregistrée lorsque Gnote est quitté."

#: data/org.gnome.gnote.gschema.xml:96
msgid "Saved sorting of the Search window."
msgstr "Tri enregistré de la fenêtre de recherche."

#: data/org.gnome.gnote.gschema.xml:97
msgid "Determines Search window initial sorting."
msgstr "Définit le tri initial de la fenêtre de recherche."

#: data/org.gnome.gnote.gschema.xml:101
msgid "FUSE Mounting Timeout (ms)"
msgstr "Délai d’expiration du montage FUSE (ms)"

#: data/org.gnome.gnote.gschema.xml:102
msgid ""
"Time (in milliseconds) Gnote should wait for a response when using FUSE to "
"mount a sync share."
msgstr ""
"Délai (en millisecondes) pendant lequel Gnote attend une réponse lorsqu’il "
"utilise FUSE pour monter un partage de synchronisation."

#: data/org.gnome.gnote.gschema.xml:106
msgid "SSHFS Remote Synchronization Folder"
msgstr "Dossier de synchronisation à distance SSHFS"

#: data/org.gnome.gnote.gschema.xml:107
msgid "Path on SSH server to Gnote synchronization directory (optional)."
msgstr ""
"Chemin sur le serveur SSH vers le répertoire de synchronisation Gnote "
"(optionnel)."

#: data/org.gnome.gnote.gschema.xml:111
msgid "SSHFS Synchronization Server URL"
msgstr "URL du serveur de synchronisation SSHFS"

#: data/org.gnome.gnote.gschema.xml:112
msgid "URL of SSH server containing Gnote synchronization directory."
msgstr "URL du serveur SSH contenant le répertoire de synchronisation Gnote."

#: data/org.gnome.gnote.gschema.xml:116
msgid "SSHFS Remote Synchronization User Name"
msgstr "Nom d’utilisateur pour la synchronisation à distance SSHFS"

#: data/org.gnome.gnote.gschema.xml:117
msgid "User name to use when connecting to the synchronization server via SSH."
msgstr ""
"Nom d’utilisateur à utiliser pour la connexion au serveur de synchronisation "
"via SSH."

#: data/org.gnome.gnote.gschema.xml:121
msgid "SSHFS Synchronization Server Port"
msgstr "Port du serveur de synchronisation SSHFS"

#: data/org.gnome.gnote.gschema.xml:122
msgid "The port to use when connecting to the synchronization server via SSH."
msgstr ""
"Le port à utiliser pour la connexion au serveur de synchronisation via SSH."

#: data/org.gnome.gnote.gschema.xml:126
msgid "Link Updating Behavior on Note Rename"
msgstr "Comportement pour la mise à jour de lien lorsqu’une note est renommée"

#: data/org.gnome.gnote.gschema.xml:127
msgid ""
"Integer value indicating if there is a preference to always perform a "
"specific link updating behavior when a note is renamed, instead of prompting "
"the user. The values map to an internal enumeration. 0 indicates that the "
"user wishes to be prompted when renaming a note may impact links that exist "
"in other notes. 1 indicates that links should automatically be removed. 2 "
"indicates that link text should be updated to the new note name so that it "
"will continue linking to the renamed note."
msgstr ""
"Nombre entier indiquant s’il est préférable d’exécuter une action spécifique "
"de mise à jour de lien quand une note est renommée plutôt que de demander à "
"l’utilisateur. Les valeurs correspondent à une énumération interne. 0 "
"indique que l’utilisateur souhaite être averti lors le fait de renommer une "
"note peut avoir un impact sur des liens qui existent dans d’autres notes. 1 "
"indique que les liens doivent être automatiquement supprimés. 2 indique que "
"le texte du lien doit être mis à jour au nouveau nom de note afin qu’il "
"continue à faire référence à la note renommée."

#: data/org.gnome.gnote.gschema.xml:131 data/org.gnome.gnote.gschema.xml:141
#: data/org.gnome.gnote.gschema.xml:146
msgid "Deprecated"
msgstr "Obsolète"

#: data/org.gnome.gnote.gschema.xml:132 data/org.gnome.gnote.gschema.xml:147
msgid "This key is deprecated and its value is ignored."
msgstr "Cette clé est obsolète et sa valeur est ignorée."

#: data/org.gnome.gnote.gschema.xml:136
msgid "Use status icon, when started as an application"
msgstr "Utiliser l’icône de statut lors d’un démarrage en tant qu’application"

#: data/org.gnome.gnote.gschema.xml:137
msgid "Deprecated, has no effect."
msgstr "Obsolète, sans effet."

#: data/org.gnome.gnote.gschema.xml:142
msgid "This setting is deprecated and its value is ignored"
msgstr "Ce paramètre est obsolète et sa valeur est ignorée"

#: data/org.gnome.gnote.gschema.xml:151
msgid "Use client side window decorations"
msgstr "Utiliser les décorations des fenêtres du côté client"

#: data/org.gnome.gnote.gschema.xml:152
msgid ""
"Should Gnote draw its window titlebar, or leave that to window manager. "
"Possible values are 'enabled' to draw them, 'disabled' to leave them to "
"window manager, or a comma separated list of desktop environments, where "
"Gnote should draw decorations itself. Requires application restart."
msgstr ""
"Gnote doit-il dessiner la barre de titre de sa fenêtre, ou laisser cela au "
"gestionnaire de fenêtres. Les valeurs possibles sont « activé » pour la "
"tracer, « désactivé » pour en laisser la charge au gestionnaire de fenêtres, "
"ou une liste d’environnements de bureau séparés par une virgule, où Gnote "
"doit dessiner les décorations lui-même. Nécessite un redémarrage de "
"l’application."

#: data/org.gnome.gnote.gschema.xml:156
msgid "Preferred color scheme to use"
msgstr "Schéma de couleur préféré à utiliser"

#: data/org.gnome.gnote.gschema.xml:157
msgid ""
"The theme variant to use. Possible values are empty string to follow the "
"system, 'dark' and 'light'."
msgstr ""
"Variante de thème à utiliser. Les valeurs possibles sont une chaîne vide "
"pour se baser sur le thème système, « dark » (« sombre ») et « light » "
"(« clair »)."

#: data/org.gnome.gnote.gschema.xml:161
msgid "Tab width in note editor"
msgstr "Largeur de tabulation dans l’éditeur de note"

#: data/org.gnome.gnote.gschema.xml:162
msgid ""
"Tab stop positions in editor will be setup using this number as a step in "
"space characters. Zero to use the default tab width."
msgstr ""
"Les positions des fins de tabulation dans l’éditeur sont définies à l’aide "
"de cette valeur en tant qu’incrémentation des caractères. Définissez cette "
"valeur à zéro pour utiliser la largeur de tabulation par défaut."

#: data/org.gnome.gnote.gschema.xml:173
msgid "HTML Export Last Directory"
msgstr "Dernier répertoire d’export HTML"

#: data/org.gnome.gnote.gschema.xml:174
msgid ""
"The last directory a note was exported to using the Export To HTML plugin."
msgstr ""
"Le dernier répertoire où une note a été exportée en utilisant le greffon "
"d’export en HTML."

#: data/org.gnome.gnote.gschema.xml:178
msgid "HTML Export Linked Notes"
msgstr "Exporter en HTML les notes liées"

#: data/org.gnome.gnote.gschema.xml:179
msgid ""
"The last setting for the 'Export linked notes' checkbox in the Export to "
"HTML plugin."
msgstr ""
"Le dernier paramètre pour la case à cocher « Exporter les notes liées » dans "
"le greffon d’export en HTML."

#: data/org.gnome.gnote.gschema.xml:183
msgid "HTML Export All Linked Notes"
msgstr "Exporter en HTML toutes les notes liées"

#: data/org.gnome.gnote.gschema.xml:184
msgid ""
"The last setting for the 'Include all other linked notes' checkbox in the "
"Export to HTML plugin. This setting is used in conjunction with the 'HTML "
"Export Linked Notes' setting and is used to specify whether all notes (found "
"recursively) should be included during an export to HTML."
msgstr ""
"Le dernier paramètre pour la case à cocher « Exporter toutes les autres "
"notes liées » dans le greffon d’export en HTML. Ce paramètre est utilisé de "
"concert avec le paramètre « Exporter les notes liées » et sert à spécifier "
"si toutes les notes (trouvées récursivement) doivent être incluses durant "
"une exportation en HTML."

#: data/org.gnome.gnote.gschema.xml:190
msgid "Synchronization Client ID"
msgstr "ID de synchronisation du client"

#: data/org.gnome.gnote.gschema.xml:191
msgid ""
"Unique identifier for this Gnote client, used when communicating with a "
"synchronization server."
msgstr ""
"Identifiant unique de ce client Gnote, utilisé lors de la communication avec "
"un serveur de synchronisation."

#: data/org.gnome.gnote.gschema.xml:195
msgid "Synchronization Local Server Path"
msgstr "Chemin du serveur local de synchronisation"

#: data/org.gnome.gnote.gschema.xml:196
msgid ""
"Path to the synchronization server when using the filesystem synchronization "
"service addin."
msgstr ""
"Chemin d’accès au serveur de synchronisation lors de l’utilisation du "
"greffon de synchronisation du système de fichiers."

#: data/org.gnome.gnote.gschema.xml:200
msgid "Selected Synchronization Service Addin"
msgstr "Greffon de synchronisation sélectionné"

#: data/org.gnome.gnote.gschema.xml:201
msgid ""
"Unique identifier for the currently configured note synchronization service "
"addin."
msgstr ""
"Identifiant unique du greffon actuellement configuré pour le service de "
"synchronisation des notes."

#: data/org.gnome.gnote.gschema.xml:205
msgid "Note Synchronization Conflict Saved Behavior"
msgstr ""
"Comportement enregistré pour les conflits lors de la synchronisation des "
"notes"

#: data/org.gnome.gnote.gschema.xml:206
msgid ""
"Integer value indicating if there is a preference to always perform a "
"specific behavior when a conflict is detected, instead of prompting the "
"user. The values map to an internal enumeration. 0 indicates that the user "
"wishes to be prompted when a conflict occurs, so that they may handle each "
"conflict situation on a case-by-case basis."
msgstr ""
"Nombre entier indiquant s’il est préférable d’exécuter une action spécifique "
"quand un conflit est détecté plutôt que de demander à l’utilisateur. Les "
"valeurs correspondent à une énumération interne. 0 indique que l’utilisateur "
"souhaite être averti lors d’un conflit, afin qu’il puisse gérer chaque "
"situation au cas par cas."

#: data/org.gnome.gnote.gschema.xml:210
msgid "Automatic Background Synchronization Timeout"
msgstr "Délai de synchronisation automatique en arrière-plan"

#: data/org.gnome.gnote.gschema.xml:211
msgid ""
"Integer value indicating how frequently to perform a background sync of your "
"notes (when sync is configured). Any value less than 1 indicates that "
"autosync is disabled. The lowest acceptable positive value is 5. Value is in "
"minutes."
msgstr ""
"Nombre entier indiquant la fréquence des synchronisations en arrière-plan de "
"vos notes (si sync est configuré). Toute valeur inférieure à 1 indique que "
"la synchronisation automatique est désactivée. La plus basse valeur "
"acceptable est 5. La valeur est en minutes."

#: data/org.gnome.gnote.gschema.xml:218
msgid "Online directory URI"
msgstr "URI de répertoire en ligne"

#: data/org.gnome.gnote.gschema.xml:219
msgid "URI to online directory where notes are synchronized to."
msgstr "URI vers un répertoire en ligne où les notes sont synchronisées."

#: data/org.gnome.gnote.gschema.xml:225
msgid "Accept SSL Certificates"
msgstr "Accepter les certificats SSL"

#: data/org.gnome.gnote.gschema.xml:226
msgid ""
"Use wdfs option \"-ac\" to accept SSL certificates without prompting the "
"user."
msgstr ""
"Utiliser l’option « -ac » de wdfs pour accepter les certificats SSL sans "
"interroger l’utilisateur."

#: data/org.gnome.gnote.gschema.xml:230
msgid "Share URL"
msgstr "URL de partage"

#: data/org.gnome.gnote.gschema.xml:231
msgid "WebDAV share URL where notes are synchronized to."
msgstr "URL de partage WebDAV où les notes sont synchronisées"

#: data/org.gnome.gnote.gschema.xml:235
msgid "Share username"
msgstr "Nom d’utilisateur de partage"

#: data/org.gnome.gnote.gschema.xml:236
msgid "Username to access WebDAV share."
msgstr "Nom d’utilisateur pour accéder au partage WebDAV."

#: data/org.gnome.gnote.gschema.xml:242
msgid "Timestamp format"
msgstr "Format de date"

#: data/org.gnome.gnote.gschema.xml:243
msgid ""
"The date format that is used for the timestamp. It follows the format of "
"strftime(3)."
msgstr ""
"Le format de date utilisé pour l’horodatage, selon le format strftime(3)."

#: data/org.gnome.gnote.gschema.xml:249
msgid "Time between checks"
msgstr "Délai entre les vérifications"

#: data/org.gnome.gnote.gschema.xml:250
msgid ""
"Time interval between note directory checks (in seconds). Min value is 5."
msgstr ""
"Délai entre les vérifications du répertoire de notes (en secondes). La "
"valeur min. est 5."

#: data/org.gnome.gnote.gschema.xml:256
msgid "Clipboard to use"
msgstr "Presse-papier à utiliser"

#: data/org.gnome.gnote.gschema.xml:257
msgid ""
"Possible values: 0 - clipboard content (last copied text), 1 - primary "
"clipboard (last selected text)."
msgstr ""
"Valeurs Possibles : 0 − contenu du presse-papier (dernier texte copié), 1 − "
